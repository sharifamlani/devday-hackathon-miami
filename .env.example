# Copy to .env and fill in. .env is gitignored: never commit real keys.
# Add .env to .worktreeinclude so agent worktrees can call the APIs too.
# Prove each key with a real call the night before (runbook.md N4).
# Traps and smoke tests: docs/hackathon-kit/playbooks/openai-integration.md

# --- OpenAI API (required: "Acceptance Criteria: Codex · OpenAI API · OpenAI Agents SDK") ---
OPENAI_API_KEY=

# One family, four price tiers. Code picks a tier by role, never a model name.
# Verified live 2026-11-06 against /v1/models + /v1/responses.
OPENAI_MODEL_FLAGSHIP="gpt-6-astra"     # hardest reasoning steps only  (~$10/$50 per 1M)
OPENAI_MODEL_DEFAULT="gpt-6.1-sol"      # agents' default workhorse     (~$2/$10)
OPENAI_MODEL_EFFICIENT="gpt-6.1-terra"  # near-Sol quality, half price  (~$1/$5)
OPENAI_MODEL_FAST="gpt-6-luna"          # high-volume classify/extract  (~$0.10/$0.50)

# low | medium | high | xhigh  (gpt-6-luna also accepts "none"; gpt-6.1-sol does not)
OPENAI_REASONING_EFFORT="medium"
OPENAI_MAX_OUTPUT_TOKENS=4000
# No temperature: every GPT-6.x model rejects it with a 400.

# --- Database / auth (only if the idea needs persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voice-first transcription (Google Gemini; docs/problem-solution-mapping.md)
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TRANSCRIBE_LIVE_MODEL=gemini-3.5-transcribe-live

# Call a donor from your own phone (service/phone.py). Your phone rings first, then the donor's, showing
# STAFF_PHONE; the call is recorded after a spoken notice, transcribed and saved as a call note.
# STAFF_PHONE must be a Twilio-verified caller ID. Calls only reach numbers on SEND_ALLOWLIST.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # optional: shown on your phone for the first leg (default: STAFF_PHONE)
STAFF_PHONE=
PHONE_CALLS=off                 # on to allow calls
SEND_ALLOWLIST=                 # comma-separated emails/phone numbers live sends and calls may reach
# PHONE_NOTICE="Hello. This call is recorded for our notes."
# PHONE_KEEP_RECORDING=1        # keep the recording on Twilio (default: deleted once the note is saved)
