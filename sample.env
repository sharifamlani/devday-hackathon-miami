# Copy this file to .env and add your OpenAI API key.
# Keep .env private; never commit credentials or place them in browser code.
OPENAI_API_KEY=

# Used by the OpenAI SDK smoke script and the Agents SDK service.
OPENAI_MODEL_FLAGSHIP=gpt-6-astra
OPENAI_MODEL_DEFAULT=gpt-6.1-sol
OPENAI_MODEL_EFFICIENT=gpt-6.1-terra
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=4000

# stat-mcp local server settings
STAT_MCP_HOST=127.0.0.1
STAT_MCP_PORT=8010
