# Copy to .env and fill in. .env is gitignored: never commit real keys.
# Add .env to .worktreeinclude so agent worktrees can call the APIs too.
# Prove each key with a real call the night before (runbook.md N4).

# --- Gemini API (Gemini + Gemma) ---
GEMINI_API_KEY=

# Open-weight model. If a prize needs open weights, the judged path reads ONLY this variable.
# Traps: playbooks/gemma4-integration.md (drop thought parts; maxOutputTokens >= 1024).
GEMMA_MODEL=gemma-4-31b-it

# Closed-weight Gemini models: fine unless a prize requires open weights.
# CURATE_MODEL=gemini-3.8-flash      # fast reading of free text into a fixed vocabulary
# GOOGLE_MODEL=
# GOOGLE_FLASH_MODEL=

# --- Database / auth (only if the idea needs persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
